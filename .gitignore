node_modules/
dist/
coverage/
.env
.env.local
.DS_Store
*.log
.claude/*
!.claude/MEMORY.md
!.claude/agents/
# settings.local.json stays ignored — it holds a personal permission allowlist —
# so the hooks block lives in settings.json, which is project tooling and tracked
# so clones and worktrees get the gate.
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/*/
.pnpm-store/
# Stryker's incremental caches live here. They are not tracked: CI publishes
# them as artifacts and `pnpm mutate:cache` fetches them, so there is one
# shared baseline rather than a tracked copy drifting against CI's.
reports/
.stryker-tmp/
