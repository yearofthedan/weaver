node_modules/
dist/
coverage/
.env
.env.local
.DS_Store
*.log
.claude/*
!.claude/MEMORY.md
!.claude/agents/
# The commit-standards gate is project tooling, not personal config: tracked so
# clones and worktrees get it. settings.local.json stays ignored — it holds a
# personal permission allowlist — so the hooks block lives in settings.json.
!.claude/hooks/
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/*/
.pnpm-store/
# Stryker's incremental caches live here. They are not tracked: CI publishes
# them as artifacts and `pnpm mutate:cache` fetches them, so there is one
# shared baseline rather than a tracked copy drifting against CI's.
reports/
.stryker-tmp/
