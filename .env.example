# Hosted eval lane config. Copy to .env (gitignored) and set WEAVER_EVAL_API_KEY.
# Do NOT commit a real key. Inject it at run time from your password manager
# instead of pasting the raw value — e.g. with Proton Pass (pass-cli):
#   pass-cli run --env-file .env -- pnpm eval
# with the value set to a secret reference: pass://<share-id>/<item-id>/API Key
WEAVER_EVAL_BASE_URL=https://openrouter.ai/api/v1
WEAVER_EVAL_MODEL=anthropic/claude-haiku-4.5
WEAVER_EVAL_API_KEY=pass://inject-via-your-password-manager-cli
