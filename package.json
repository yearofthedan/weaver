{
  "name": "@yearofthedan/weaver",
  "version": "0.1.11",
  "packageManager": "pnpm@12.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/yearofthedan/weaver.git"
  },
  "description": "Headless CLI refactoring engine for AI agents",
  "license": "MIT",
  "keywords": [
    "refactoring",
    "typescript",
    "vue",
    "ai",
    "ts-morph",
    "volar",
    "rename",
    "move",
    "code-tools",
    "compiler",
    "ai-agent"
  ],
  "bin": {
    "weaver": "./dist/adapters/cli/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    ".claude/skills/weaver-search-and-replace",
    ".claude/skills/weaver-refactor",
    ".claude/skills/weaver-code-inspection"
  ],
  "main": "./dist/adapters/cli/cli.js",
  "exports": {
    ".": "./dist/adapters/cli/cli.js"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/adapters/cli/cli.js",
    "dev": "tsx src/adapters/cli/cli.ts",
    "test": "vitest run",
    "test:eval": "vitest run --config eval/vitest.config.ts",
    "test:all": "pnpm test && pnpm test:eval",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist .stryker-tmp",
    "test:mutate": "rm -rf .stryker-tmp && stryker run",
    "test:mutate:file": "rm -rf .stryker-tmp && stryker run --mutate",
    "test:mutate:eval": "rm -rf .stryker-tmp && stryker run stryker.eval.config.mjs",
    "test:mutate:eval:file": "rm -rf .stryker-tmp && stryker run stryker.eval.config.mjs --mutate",
    "eval": "vitest run --config eval/vitest.llm.config.ts",
    "eval:gate": "tsx scripts/eval-gate.ts",
    "typecheck:eval": "tsc --project tsconfig.eval.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "check": "biome check . && pnpm build && pnpm coverage && pnpm test:eval && pnpm typecheck:eval && pnpm typecheck:test",
    "setup:dev": "bash scripts/setup-dev.sh",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@volar/typescript": "2.4.28",
    "@vue/language-core": "3.3.11",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "safe-regex2": "5.1.1",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3",
    "zod": "4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.3",
    "@types/tmp": "0.2.6",
    "@vitest/coverage-v8": "4.1.11",
    "@volar/language-core": "2.4.28",
    "@yearofthedan/weaver": "link:.",
    "husky": "9.1.7",
    "tmp": "0.2.7",
    "tsx": "4.23.13",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
